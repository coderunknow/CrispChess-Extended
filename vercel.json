{
  "installCommand": "export PATH=$HOME/f/bin:$PATH; [ -x $HOME/f/bin/flutter ] || git clone -q --depth 1 -b stable https://github.com/flutter/flutter.git $HOME/f; flutter --version && flutter pub get",
  "buildCommand": "export PATH=$HOME/f/bin:$PATH; dart run intl_utils:generate || flutter gen-l10n || true; flutter build web --release --wasm || flutter build web --release",
  "outputDirectory": "build/web",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*).wasm",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.js$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}
