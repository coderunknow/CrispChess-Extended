# iOS 15: CrispASR's framework (voice moves) targets 15.0 since v0.8.38.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# --- onnxruntime-objc CDN repair -----------------------------------------
# The onnxruntime Flutter plugin (^1.4.1) pins `onnxruntime-objc 1.15.1`, whose
# pod archives are hosted on a retired Azure CDN
# (onnxruntimepackages.z14.web.core.windows.net) that now returns HTTP 404,
# making `pod install` fail before any build starts. onnxruntime-objc 1.18.0 is
# the first release published to the current CDN (download.onnxruntime.ai) and
# is API-compatible with the plugin. Rewrite the plugin's podspec dependency to
# the working version before CocoaPods resolves, so the run pulls from the live
# CDN instead of the dead one. Wrapped so a patch failure never breaks the
# Podfile load itself.
begin
  pub_cache = ENV['PUB_CACHE'] || File.join(Dir.home, '.pub-cache')
  podspec = Dir.glob(File.join(pub_cache, 'hosted', 'pub.dev', 'onnxruntime-*',
                              'ios', 'onnxruntime.podspec')).first
  if podspec && File.exist?(podspec)
    content = File.read(podspec)
    unless content.include?('1.18.0')
      patched = content.sub(/(s\.dependency\s+'onnxruntime-objc',\s+)'1\.15\.1'/) do
        "#{$1}'1.18.0'"
      end
      File.write(podspec, patched) if patched != content
    end
  end
rescue => e
  warn "[crispchess] onnxruntime podspec CDN patch skipped: #{e.message}"
end

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
